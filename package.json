{
  "name": "wan-nee-la",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
    "deploy": "wrangler deploy --config $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "cf-typegen": "wrangler types --config $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
    "build:client": "esbuild src/client/app.ts --bundle --format=iife --minify --target=es2020 --outfile=public/app.js",
    "build:docs": "mkdir -p public/docs && cp node_modules/swagger-ui-dist/swagger-ui-bundle.js node_modules/swagger-ui-dist/swagger-ui.css public/docs/",
    "predeploy": "npm run build:client && npm run build:docs",
    "db:init": "for f in migrations/*.sql; do wrangler d1 execute wan-nee-la --local --file=$f || exit 1; done",
    "db:seed": "wrangler d1 execute wan-nee-la --local --file=migrations/0002_seed.sql",
    "db:init:remote": "for f in migrations/*.sql; do wrangler d1 execute wan-nee-la --remote --file=$f || exit 1; done",
    "db:seed:remote": "wrangler d1 execute wan-nee-la --remote --file=migrations/0002_seed.sql",
    "test:dates": "node --experimental-strip-types scripts/test-dates.mjs",
    "test:leave": "node --experimental-strip-types scripts/test-leave.mjs",
    "test": "npm run test:dates && npm run test:leave && npm run test:line && npm run test:push && npm run test:holidays && npm run test:i18n && npm run test:openapi",
    "test:line": "node --experimental-strip-types scripts/test-line.mjs",
    "test:push": "node --experimental-strip-types scripts/test-push.mjs",
    "test:holidays": "node --experimental-strip-types scripts/test-holidays.mjs",
    "test:i18n": "node --experimental-strip-types scripts/test-i18n.mjs",
    "test:openapi": "node scripts/check-openapi.mjs",
    "vapid": "node scripts/vapid-keys.mjs",
    "icons": "node scripts/icons.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "ship": "node scripts/ship.mjs",
    "openapi:shield": "node scripts/openapi-shield.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "format:check": "eslint ."
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "swagger-ui-dist": "^5.32.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.135.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260811.1": true
  }
}
