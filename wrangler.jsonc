{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wan-nee-la",
	"account_id": "<account-id>",
	"main": "src/index.tsx",
	"compatibility_date": "2026-08-01",

	// Never expose a workers.dev URL. Cloudflare Access protects the custom hostname only,
	// so a workers.dev route would be an unauthenticated bypass to every employee's leave data.
	// Deploy fails until the route below is filled in — that is the intended safe default.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "leave.example.com",
			"custom_domain": true,
		},
	],

	"observability": {
		"enabled": true,
	},

	// Deployment version id + upload timestamp, populated by the platform at deploy time.
	// Surfaced in /health and the page footer so a production check can prove which code answered.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},

	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wan-nee-la",
			"database_id": "<database-id>",
		},
	],

	// 01:00 UTC = 08:00 Asia/Bangkok. Thailand has no DST, so this offset is fixed.
	// Phase 4 (LINE push) is not implemented yet; the handler is a no-op stub for now.
	"triggers": {
		"crons": ["0 1 * * *"],
	},

	"vars": {
		// Cloudflare Access team domain.
		"ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
		// Access application AUD tag. Both must be set before the app will serve anything.
		"ACCESS_AUD": "<access-aud>",
		// "1" bypasses Access verification and logs in as DEV_EMAIL. Local development only.
		// Setting this in production hands every visitor an admin session.
		"DEV_AUTH_BYPASS": "0",
		"DEV_EMAIL": "dev@example.com",
		// Optional pin for the LINE group. Normally left empty: /line/webhook
		// captures the group id into app_config the first time the bot sees a
		// message in the group.
		//
		// The two LINE credentials are SECRETS and must never appear in this file:
		//   wrangler secret put LINE_CHANNEL_ACCESS_TOKEN
		//   wrangler secret put LINE_CHANNEL_SECRET
		"LINE_GROUP_ID": "",
	},
}
