{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wan-nee-la",
	"main": "src/index.tsx",
	"compatibility_date": "2026-08-01",

	// ---------------------------------------------------------------------------
	// This file is a TEMPLATE, committed with placeholders.
	//
	// Copy it to `wrangler.local.jsonc` (gitignored), fill in the four values
	// marked REPLACE_ME below, and the npm scripts will prefer that copy
	// automatically. Keeping the real ids out of the repo means a public clone
	// does not advertise which account, hostname and Access application hold a
	// given company's leave data.
	//
	// Nothing here is a credential. The two LINE secrets never live in any config
	// file — see `vars` at the bottom.
	// ---------------------------------------------------------------------------

	// Your Cloudflare account id. Alternatively drop this key and export
	// CLOUDFLARE_ACCOUNT_ID in the environment.
	"account_id": "REPLACE_ME_ACCOUNT_ID",

	// Never expose a workers.dev URL. Cloudflare Access protects the custom
	// hostname only, so a workers.dev route would be an unauthenticated bypass to
	// every employee's leave data.
	"workers_dev": false,
	"routes": [
		{
			// The hostname staff will use. Its zone must be in the same account.
			"pattern": "REPLACE_ME_HOSTNAME",
			"custom_domain": true,
		},
	],

	"observability": {
		"enabled": true,
	},

	// Deployment version id + upload timestamp, populated by the platform at deploy time.
	// Surfaced in /health and the page footer so a production check can prove which code answered.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},

	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wan-nee-la",
			// From `wrangler d1 create wan-nee-la`.
			"database_id": "REPLACE_ME_DATABASE_ID",
		},
	],

	// 02:00 UTC = 09:00 Asia/Bangkok. Thailand has no DST, so the offset is fixed.
	//
	// Mon-Fri is expressed here as well as enforced in runDigest(), which skips
	// weekends and public holidays on its own. The cron restriction is the cheap
	// half — it stops the Worker waking twice a week to decide it has nothing to
	// do — and the code remains the authority, since only it knows about
	// holidays.
	//
	// The day-of-week field is evaluated in UTC, so it only lines up with the
	// Bangkok week because 02:00 UTC is the same calendar day in Bangkok (09:00).
	// Moving this later than 17:00 UTC would put the fire on the next Bangkok day
	// and silently shift the weekdays; the hour and the 1-5 belong together.
	"triggers": {
		"crons": ["0 2 * * 1-5"],
	},

	"vars": {
		// Cloudflare Access team domain, e.g. "acme.cloudflareaccess.com", and the
		// Access application's AUD tag. The app fails closed while either is empty,
		// so an unconfigured deployment serves nothing.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",

		// "1" bypasses Access verification and logs in as DEV_EMAIL. Local development only.
		// Setting this in production hands every visitor an admin session.
		"DEV_AUTH_BYPASS": "0",
		"DEV_EMAIL": "dev@example.com",

		// Access service tokens allowed to read the JSON feeds, comma-separated,
		// by the name Access knows each token by. Empty means no machine may call
		// this app — the safe default. A token also needs an Access policy that
		// admits it; this list is the second gate, edited here rather than in the
		// Access dashboard. See the README, "Letting a machine read the feeds".
		"SERVICE_TOKENS": "",

		// Feature flag for the whole LINE channel. "1" turns it on; anything else,
		// including this key being absent, leaves it off.
		//
		// Off by default and fails closed on purpose: LINE posts into a company
		// group and bills a push per member (ISSUES #2), so a missing variable
		// must never be the thing that starts it sending. Browser push is
		// unaffected and has its own switch — the VAPID pair.
		"LINE_ENABLED": "0",

		// Optional pin for the LINE group. Normally left empty: /line/webhook
		// captures the group id into app_config the first time the bot sees a
		// message in the group.
		//
		// The two LINE credentials are SECRETS and must never appear in this file:
		//   wrangler secret put LINE_CHANNEL_ACCESS_TOKEN
		//   wrangler secret put LINE_CHANNEL_SECRET
		"LINE_GROUP_ID": "",

		// Browser push (VAPID). Generate a pair with `npm run vapid`.
		//
		// The public key is handed to every browser that subscribes, so it belongs
		// here rather than in a secret. The private key is what signs pushes and
		// must be stored as one:
		//   wrangler secret put VAPID_PRIVATE_KEY
		//
		// Leave both empty to keep browser notifications switched off — the card
		// on /me disappears and the digest simply skips the channel.
		"VAPID_PUBLIC_KEY": "",
		// Contact address for the push services, e.g. "mailto:ops@example.com".
		"VAPID_SUBJECT": "",
	},
}
